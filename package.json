{
  "name": "attendance-workspace",
  "private": true,
  "workspaces": [
    "js/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build",
    "dev": "vite examples/web --config examples/web/vite.config.ts",
    "build:example": "tsc -p examples/web/tsconfig.json && vite build examples/web --config examples/web/vite.config.ts",
    "generate:types": "openapi-typescript docs/openapi.json -o js/attendance-client/src/schema.ts --default-non-nullable false",
    "test:web": "playwright test",
    "test:client": "node --test tests/js/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  },
  "type": "module"
}
